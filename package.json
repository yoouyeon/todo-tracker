{
  "name": "todo-tracker",
  "version": "0.1.1",
  "description": "월별 Markdown 노트의 할 일을 옵시디언에서 확인하고 편집하는 플러그인",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "install-local": "node scripts/install-local.mjs"
  },
  "author": "yoouyeon",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
